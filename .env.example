#--------------------------------------------------------------------
# POLARA ENVIRONMENT VARIABLES EXAMPLE
# Salin berkas ini ke Environment Variables di dashboard Vercel
# JANGAN simpan password/secret produksi ke dalam repository publik
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# URL dasar aplikasi di Vercel (bisa dikosongkan agar otomatis mendeteksi domain)
# app.baseURL = 'https://polara.vercel.app/'
app.indexPage = ''

# Konfigurasi Database Cloud (MySQL / MariaDB Remote, misal: Aiven, PlanetScale, TiDB, Railway)
database.default.hostname = your-cloud-db-host.com
database.default.database = polara
database.default.username = your_db_username
database.default.password = your_db_password
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

# Keamanan & Session
security.csrfProtection = 'session'
security.tokenRandomize = true
